# Copy to .env (it is gitignored) and fill in.
# Voice phase only. Rendering and the score engine never touch the network.

FISH_API_KEY=
# s2.1-pro-free is the no-cost tier; switch to s2.1-pro for production voice.
FISH_MODEL=s2.1-pro-free
# Optional: a cloned voice id from https://fish.audio . Empty = default voice.
FISH_VOICE_ID=

# Optional voice provider: word-level timestamps for explainer headlines.
# Never committed; the free plan may block library voices (402).
ELEVENLABS_API_KEY=

# Optional asset generation (music/SFX/key art) via Scenario MCP.
# The studio's own score engine works without it.
SCENARIO_API_KEY=

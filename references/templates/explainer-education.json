{
  "id": "explainer-education",
  "title": "Explainer: the mechanism drawn in order",
  "when": {
    "kind": [
      "explainer",
      "editorial",
      "app-demo"
    ],
    "aspects": [
      "16x9",
      "9x16"
    ],
    "energy": "low",
    "audience": [
      "students",
      "teachers",
      "institutions"
    ],
    "dialect": [
      "ar-msa"
    ],
    "duration": [
      40,
      90
    ]
  },
  "structure": {
    "beats": [
      {
        "kind": "hook",
        "bars": 3,
        "role": "the question the viewer already has"
      },
      {
        "kind": "device",
        "bars": 6,
        "role": "step one: the input, on the real screen"
      },
      {
        "kind": "stat",
        "bars": 4,
        "role": "the measurable middle"
      },
      {
        "kind": "device",
        "bars": 6,
        "role": "step two: the output, same framing"
      },
      {
        "kind": "cta",
        "bars": 4,
        "role": "the one action"
      }
    ],
    "total_bars": 23
  },
  "look": "paper-clean",
  "palette": {
    "ground": "#FBF7F0",
    "surface": "#FFFFFF",
    "ink": "#1A2A36",
    "accent": "#0E8A6E",
    "support": "#D6EFE6"
  },
  "typography": {
    "face": "Tajawal",
    "display_px": [
      56,
      80
    ],
    "body_px": [
      28,
      36
    ],
    "line_height": 1.3,
    "weights": [
      400,
      700
    ],
    "rules": [
      "One idea per beat, 8-14 words on screen.",
      "Labels stay above 28 px; if it needs a key, cut the diagram.",
      "Three lines maximum per plate; a fourth line is a second beat."
    ]
  },
  "layouts": [
    "paper-card",
    "evidence-grid",
    "timeline-strip",
    "end-card"
  ],
  "transitions": [
    "blur",
    "slide"
  ],
  "sfx": {
    "intro": "page_flip",
    "cut": "whoosh_rtl",
    "accent": "ding"
  },
  "background": "paper-glow",
  "motion": 0.35,
  "reference": {
    "site": "prompt-motion.com",
    "url": "https://prompt-motion.com/",
    "pattern": "diagrams",
    "move": "Draw the mechanism in order, one node at a time.",
    "note": "Explainer anatomy adapted from prompt-motion's diagrams reference set; pattern only."
  },
  "guardrails": [
    "If a step needs a footnote, it is not explained yet; rewrite the step."
  ]
}

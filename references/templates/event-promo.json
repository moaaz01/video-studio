      },
      {
        "kind": "stat",
        "bars": 4,
        "role": "the date as the number that lands"
      },
      {
        "kind": "device",
        "bars": 4,
        "role": "the place or program, visual evidence"
      },
      {
        "kind": "hook",
        "bars": 3,

      ]
    },
    {
      "start": 780,
      "duration": 98,
      "lines": [
        "ستّةُ أضعافِ السرعة، في نفس الوقت."
      ]
    },
    {
      "start": 1020,
      "duration": 108,
      "lines": [
        "حمّل التطبيقَ الآن،",
        "وابدأ بصفحتك الأولى."
      ]
    }

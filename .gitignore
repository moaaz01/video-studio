# secrets — never commit
.env
.env.*
!.env.example

# renders (large, regenerable)
out/
*.mp4
*.mov
*.webm
*.mkv

# audio: the delivered VO and bed are committed so a fresh clone renders with
# sound; the Fish call and the composer reproduce them (voice.py / make_bed.py)
!public/audio/vo/
!public/audio/vo/*.wav
!public/audio/score/
!public/audio/score/*.wav
public/audio/score/music.orig.wav
!public/audio/sfx/

# tooling
node_modules/
.DS_Store
Thumbs.db
__pycache__/
*.pyc
.venv/
venv/

# editor
.vscode/
.idea/
*.swp

# QA artefacts
out/qa/
film/ui-source.json
references/corpus/.cache/
references/corpus/evidence/

# generated previews (rendered on demand)
out/looks/
out/storyboard/
public/luts/
